# Copy thành .env rồi ĐIỀN KEY THẬT. KHÔNG commit .env.
# KHÔNG dùng NEXT_PUBLIC_ cho secret — mọi secret chỉ server-side.
# Thiếu key → feature tự disable an toàn, build không fail.
DATABASE_URL=
TYPESENSE_HOST=
TYPESENSE_API_KEY=
TAVILY_API_KEY=
TAVILY_INCLUDE_DOMAINS=
SERAPI_API_KEY=
ANALYTICS_WRITE_KEY=
INGEST_WEBHOOK_SECRET=
